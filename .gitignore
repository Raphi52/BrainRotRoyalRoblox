# Sauvegardes automatiques laissees par les outils d'edition (elles restent sur le disque,
# elles ne sont simplement pas suivies : l'historique git les remplace desormais).
*.bak
*.bak-*

# Verrous et copies de travail de Roblox Studio
*.rbxlx.lock
*.autotest.rbxlx

# Python
__pycache__/
*.pyc

# Places construites par build.py : regenerables a tout moment, plusieurs centaines de Ko
# chacune. BrainRotRoyale.rbxlx reste SUIVI a dessein : c'est la place publiee.
place-*.rbxlx
priv-*.rbxlx

# Places construites a la main pour une capture ponctuelle (nommees d'apres la conversation ou le
# sujet). Comme place-*.rbxlx : regenerables par build.py, plusieurs centaines de Ko chacune.
/*.conv*.rbxlx
/*.recap.rbxlx

# Captures d'ecran de verification (Studio) prises a la racine. Les icones de la boutique,
# elles, sont de VRAIS assets du jeu et restent suivies (tools/boutique/*.png).
/capture-*.png
# photos de test, rangees ici par defaut depuis le 2026-09-21 (outils studio-capture-*.ps1)
/captures/
/cap-*.png
/decor-*.png
/recap-*.png
/crop-*.png
/captures-ratees/
/captures-perimees/

# Journaux Studio et simulations : plusieurs milliers de lignes, rejouables par build.py
*.log

# Script de lancement Studio jetable (chemins de CETTE machine)
/_run3.ps1

# Base de connaissances locale : ce n'est pas le jeu.
/brain/
# anciennes sauvegardes .bak rangees hors de la racine (2026-09-21), jamais supprimees
/archives/

# captures d ecran ponctuelles posees a la racine (les vrais assets vivent dans tools/boutique/)
/*.png
# ancienne copie de travail d une refonte du menu
/.remake-menu/

# Bibliotheque standard Roblox de selene : ~750 Ko, regeneree par tools/test_lint.py.
/roblox.yml
