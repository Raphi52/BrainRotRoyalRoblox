		color = Color3.fromRGB(150, 220, 90),
		hp = 0, dmg = 0, range = 0, speed = 0, atkSpeed = 0, count = 0, targets = "any",
		size = Vector3.new(1, 1, 1),
	},
	{
		id = "CuraLimone", name = "Cura Limone", cost = 3, desc = "Sort : soigne tes unites dans la zone",
